{
  "version": 2,
  "functions": {
    "api/leads.js": {
      "includeFiles": "api/reports/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/leads.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/$1"
    }
  ]
}
